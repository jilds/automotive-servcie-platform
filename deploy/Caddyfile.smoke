# Smoke run only (compose.smoke.yaml): Caddy's own CA instead of Let's Encrypt, on names that resolve to this machine.
{
	local_certs
	skip_install_trust
}

import caddy/site.caddy

app.localhost {
	encode zstd gzip
	# Request body limits: 1 MB by default, 6 MB for photo uploads (5 MB file), 16 KB for a payment provider's webhook
	# (the app also refuses a larger one before reading it).
	@billingWebhook path_regexp ^/api/v1/public/[^/]+/billing/webhooks/
	@photoUpload path_regexp ^/api/v1/work-orders/[^/]+/photos
	handle @billingWebhook {
		request_body {
			max_size 16KB
		}
		reverse_proxy app:8080
	}
	handle @photoUpload {
		request_body {
			max_size 6MB
		}
		reverse_proxy app:8080
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8080
	}
}

localhost {
	import site https://app.localhost:18443
}
