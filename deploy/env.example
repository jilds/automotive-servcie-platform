# Template for deploy/.env (never committed): cp deploy/env.example deploy/.env, then fill it in.
# Generate each secret with: openssl rand -base64 48. See docs/release/runbook.md.

# The image CI pushed for a release tag.
ASP_IMAGE=ghcr.io/jilds/asp:1.0.0

# Host names (DNS A/AAAA records pointing at this server) and the address Let's Encrypt writes to.
ASP_APP_DOMAIN=app.asp.example
ASP_SITE_DOMAIN=asp.example
ASP_ACME_EMAIL=ops@asp.example

# The landing site (step 03) on ASP_SITE_DOMAIN: the folder with its build (site/dist, runbook §2; relative paths are
# read from deploy/), unset: the placeholder in deploy/site. Its origin may post the demo request form; unset, it is
# https://ASP_SITE_DOMAIN. The privacy policy linked from the public booking page: an absolute https URL, empty for
# no link (set it once the legal pages are final, docs/release/checklist.md).
ASP_SITE_DIR=../site/dist
# ASP_SITE_ORIGIN=https://asp.example
# ASP_SITE_PRIVACY_URL=https://asp.example/privacidade

# Database: the superuser (maintenance and backups only), the migration owner and the app role.
ASP_DB_ADMIN_PASSWORD=
ASP_DB_OWNER_PASSWORD=
ASP_DB_APP_PASSWORD=

# Signs the sign-in tokens: at least 32 random bytes. Changing it signs everybody out.
ASP_JWT_SECRET=

# Mail through any SMTP provider (port 587 with STARTTLS).
ASP_MAIL_ENABLED=false
ASP_MAIL_HOST=
ASP_MAIL_PORT=587
ASP_MAIL_USERNAME=
ASP_MAIL_PASSWORD=
ASP_MAIL_FROM=ASP <noreply@asp.example>

# First start only: creates the first platform admin. Remove all three after the first sign-in.
ASP_BOOTSTRAP_ADMIN_EMAIL=
ASP_BOOTSTRAP_ADMIN_PASSWORD=
ASP_BOOTSTRAP_ADMIN_NAME=

# Optional.
# ASP_SUBSCRIPTION_GRACE_DAYS=7
# ASP_SITE_LEADS_PER_HOUR=50

# Backups (deploy/backup.sh): the folder (outside the git checkout) and days kept on the server, and the
# S3-compatible bucket for off-site copies.
ASP_BACKUP_DIR=/var/backups/asp
ASP_BACKUP_KEEP_DAYS=14
ASP_BACKUP_S3_BUCKET=
# Empty for AWS S3; otherwise the provider's endpoint, for example https://s3.eu-central-003.backblazeb2.com
ASP_BACKUP_S3_ENDPOINT=
ASP_BACKUP_S3_REGION=eu-central-1
ASP_BACKUP_S3_ACCESS_KEY_ID=
ASP_BACKUP_S3_SECRET_ACCESS_KEY=
