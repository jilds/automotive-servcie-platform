# The landing site (step 03): static files from /srv/site (ASP_SITE_DIR, runbook §2), imported by Caddyfile and
# Caddyfile.smoke as `import site <app origin>`. The app origin is the only other place the pages may talk to (the
# demo request form posts to /api/v1/public-site/leads there).

# Security headers, on pages and on the 404 page alike.
(site-headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# No inline scripts or styles: the build emits both as files (astro.config.mjs).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {args[0]}; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}
}

(site) {
	encode zstd gzip
	root * /srv/site
	file_server
	import site-headers {args[0]}

	# Astro's build output: the file name carries the content hash, so a new version is a new URL.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Pages and unhashed files are checked again on every visit (ETag), so a new deploy shows at once.
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "no-cache"

	handle_errors 404 {
		import site-headers {args[0]}
		header Cache-Control "no-cache"
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}
